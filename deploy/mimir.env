# OrderMyPhotos on Mimir (github.com/mswietlicki/mimir). Paths only, no secrets.
#   docker compose -p omp --env-file deploy/mimir.env up -d --build
# One app, one session at a time. A session's root is picked in the app from OMP_ROOTS:
# - /srv/mimir/onedrive/pristine/mirror: the whole OneDrive library, read from the "pristine" snapshot, not the
#   mirror itself, so files don't move under a run that takes days (pristine is a symlink to the snapshot);
# - /srv/mimir/cache/photos/tests: test sets (reflinked copies of parts of the mirror).
OMP_ROOTS=/srv/mimir/onedrive/pristine:/srv/mimir/cache/photos/tests
OMP_LIBRARIES_A=/srv/mimir/onedrive
OMP_LIBRARIES_B=/srv/mimir/cache/photos/tests
OMP_STATE=/srv/mimir/data/photos
OMP_SESSIONS_CACHE_DIR=/srv/mimir/cache/photos/sessions
OMP_MODELS_DIR=/srv/mimir/models
OMP_MANIFESTS_DIR=/srv/mimir/onedrive/manifests
OMP_WEB_PORT=8790
