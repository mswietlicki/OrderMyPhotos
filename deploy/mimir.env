# The whole OneDrive library on Mimir (github.com/mswietlicki/mimir). Paths only, no secrets.
#   docker compose -p omp --env-file deploy/mimir.env up -d --build
# The library is the "pristine" snapshot of the mirror, not the mirror itself: a run that takes days needs
# files that don't move under it while the hourly pull goes on. Live mode catches up afterwards.
OMP_LIBRARY=/srv/mimir/onedrive/.snapshots/PRISTINE/snapshot/mirror
OMP_BUNDLE_DIR=/srv/mimir/cache/photos/library/bundle
OMP_STATE=/srv/mimir/data/photos
OMP_CACHE_DIR=/srv/mimir/cache/photos/library/cache
OMP_MODELS_DIR=/srv/mimir/models
OMP_MANIFESTS_DIR=/srv/mimir/onedrive/manifests
OMP_LIBRARY_INDEX=manifest
OMP_RUN=full
OMP_WEB_PORT=8790
