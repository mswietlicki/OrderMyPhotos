# The omp XMP namespace (metadata.py, design.md S9): what OrderMyPhotos wrote into a photo, so the next write
# recognizes its own values and leaves the ones the user wrote or changed since.
#     exiftool -config exiftool.config -XMP-omp:all photo.jpg
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        omp => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::omp' } },
    },
);
%Image::ExifTool::UserDefined::omp = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-omp', 2 => 'Image' },
    NAMESPACE => { 'omp' => 'https://github.com/mswietlicki/OrderMyPhotos/xmp/1.0/' },
    WRITABLE  => 'string',
    Version             => { },                # metadata.py's VERSION
    Run                 => { },                # the run whose plan wrote it
    Original            => { },                # the photo's QuickXorHash before the first write: still the same photo
    WrittenTitle        => { },                # the title as written: changed since, it's the user's
    WrittenDescription  => { },
    WrittenKeywords     => { List => 'Bag' },  # the flat keywords it added
    WrittenHierarchical => { List => 'Bag' },  # the hierarchical ones, with "/"
    WrittenRegions      => { Writable => 'integer' },  # how many regions it wrote (0: the regions aren't its)
);
1;  # end
